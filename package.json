{
  "name": "srisai-model-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "start:render": "npm run prisma:push && npm run prisma:bootstrap-admin && npm run start",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=server/prisma/schema.prisma",
    "prisma:bootstrap-admin": "node server/prisma/bootstrap-admin.js",
    "backup:render-data": "node server/prisma/backup-render-data.js",
    "import:development": "node server/prisma/ensure-development-data.js",
    "clear:development": "node server/prisma/clear-development-csv.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "prisma": "^5.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
