			"args": [
				"--input-type=module",
				"-e",
				"import { writeFile } from 'node:fs/promises'; const classes=['Nursery','LKG','UKG',...Array.from({length:10},(_,i)=>`Class ${i+1}`)]; const subjects=['English','Mathematics','Science','Social Studies','Hindi','Telugu','Computer Science','Physical Education']; const teacherLines=['Teacher ID,Teacher Name,Username,Initial Password,Assigned Subject,Assigned Class,Assigned Section,Is Class Teacher,Active']; for(let i=0;i<25;i++){const c=classes[i%classes.length]; teacherLines.push(`DUMMY-TCH-${String(i+1).padStart(3,'0')},Development Teacher ${String(i+1).padStart(2,'0')},dummyteacher${String(i+1).padStart(2,'0')},DummyTeach#${String(i+1).padStart(2,'0')},${subjects[i%subjects.length]},${c},A,${i<13},true`)} const studentLines=['Student ID,Student Name,Username,Initial Password,Class,Section,Roll Number,Room Number,Academic Year,Gender,Parent Name,Parent Contact,Email,Address']; let n=0; for(const c of classes){const m=/Class (\\\\d+)/.exec(c); const prefix=m?m[1].padStart(2,'0'):String(classes.indexOf(c)+1).padStart(2,'0'); for(let r=1;r<=30;r++){n++; const roll=prefix+String(r).padStart(2,'0'); studentLines.push(`DUMMY-STU-${String(n).padStart(4,'0')},Development Student ${String(n).padStart(3,'0')},dummystudent${String(n).padStart(4,'0')},DummyStud#${String(n).padStart(4,'0')},${c},A,${roll},ROOM-${prefix},2026-2027,Unspecified,,,dummystudent${String(n).padStart(4,'0')}@development.invalid,Development record`)}} await writeFile('dummy_teachers.csv',teacherLines.join('\\n')+'\\n'); await writeFile('dummy_students.csv',studentLines.join('\\n')+'\\n'); console.log('Generated replaceable development CSVs:',teacherLines.length-1,'teachers and',studentLines.length-1,'students');"
			],
			"isBackground": false,
			"problemMatcher": []
